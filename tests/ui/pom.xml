<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>lottery-ui-auto</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>lottery_system Selenium UI Automation</name>
    <description>抽奖系统 Web UI 自动化测试工程（Selenium WebDriver + JUnit5）</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <selenium.version>4.51.0</selenium.version>
        <allure.version>2.27.0</allure.version>
        <!-- Allure 结果输出目录（生成 HTML 报告：见 README 第四节） -->
        <allure.results.directory>${project.basedir}/reports/allure-results</allure.results.directory>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <version>1.10.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Allure：生成测试报告（含用例分组、失败详情、截图附件、环境信息） -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                    <systemPropertyVariables>
                        <allure.results.directory>${allure.results.directory}</allure.results.directory>
                    </systemPropertyVariables>
                    <!--
                        SE_OFFLINE=true：让 Selenium Manager 走离线模式。
                        它默认每次启动驱动都要联网拉 known-good-versions 清单，
                        本机出网需代理，直连会一直卡到超时（实测单个测试类被拖到 240s+，
                        而用例本身合计只有 21s）。BaseUiTest 已改为直接使用本机缓存里的
                        chromedriver，这一步是兜底：即使缓存匹配失败，也不会再白等几分钟。
                    -->
                    <environmentVariables>
                        <SE_OFFLINE>true</SE_OFFLINE>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!-- 把 issues/categories/environment 等元数据写进 allure-results（报告首页展示） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>allure-metadata</id>
                        <phase>test</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${allure.results.directory}"/>
                                <copy todir="${allure.results.directory}">
                                    <fileset dir="${project.basedir}/allure-metadata"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
